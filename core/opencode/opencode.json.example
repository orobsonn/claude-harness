{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-terra",
  "subagent_depth": 5,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "explore": {
      "permission": {
        "task": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
      "webfetch": "allow",
      "websearch": "allow",
      "configure-routing": "deny",
      "lifecycle-update": "deny",
      "edit": "deny"
      }
    },
    "general": {
      "permission": {
        "task": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
      "webfetch": "allow",
      "websearch": "allow",
      "configure-routing": "deny",
      "lifecycle-update": "deny",
      "edit": "allow"
      }
    }
  },
  "plugin": [],
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".dev.vars": "deny",
      "**/.dev.vars": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      ".opencode/plans/.state/**": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".dev.vars": "deny",
      "**/.dev.vars": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "question": "allow",
    "configure-routing": "ask",
    "lifecycle-update": "ask",
    "bash": {
      "*": "allow",
      "npx --yes --package=github:orobsonn/claude-harness#v* claude-harness lifecycle-update *": "deny",
      "npx tsc --noEmit": "allow",
      "npx --yes --package=github:orobsonn/claude-harness#v* claude-harness init --target opencode": "allow",
      "npx --yes --package=github:orobsonn/claude-harness#v* claude-harness init --target claude": "allow",
      "npx --yes --package=github:orobsonn/claude-harness#v* claude-harness init --target both": "allow",
      "npm test": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "npm run typecheck": "allow",
      "npm ci*": "allow",
      "npm list*": "allow",
      "npm info*": "allow",
      "pnpm test*": "allow",
      "pnpm run*": "allow",
      "yarn test*": "allow",
      "bun test*": "allow",
      "bun run*": "allow",
      "vitest*": "allow",
      "jest*": "allow",
      "tsc --noEmit*": "allow",
      "eslint*": "allow",
      "prettier*": "allow",
      "node*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git fetch*": "allow",
      "git pull": "allow",
      "git stash*": "allow",
      "git restore*": "allow",
      "gh *": "allow",
      "node --test *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "which*": "allow",
      "echo*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "sed*": "allow",
      "awk*": "allow",
      "diff*": "allow",
      "stat*": "allow",
      "file*": "allow",
      "jq*": "allow",
      "wc*": "allow",
      "mkdir*": "allow",
      "touch*": "allow",
      "cp*": "allow",
      "mv*": "allow",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push -f*": "deny",
      "git push * -f*": "deny",
      "git clean -f*": "deny",
      "rm -r*": "deny",
      "rm -R*": "deny",
      "rm -fr*": "deny",
      "rm --recursive*": "deny",
      "node*.opencode/plans/.state/*": "deny",
      "python*.opencode/plans/.state/*": "deny",
      "sed *.opencode/plans/.state/*": "deny",
      "tee *.opencode/plans/.state/*": "deny",
      "rm *.opencode/plans/.state/*": "deny",
      "git push --force-with-lease*": "allow",
      "git push * --force-with-lease*": "allow"
    }
  }
}
