{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.3",
  "small_model": "xai/grok-build-0.1",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "./.opencode/plugin/entry-gate.ts",
    "./.opencode/plugin/plan-gate.ts",
    "./.opencode/plugin/plan-write-gate.ts",
    "./.opencode/plugin/loop-guard.ts",
    "./.opencode/plugin/reinject-state.ts",
    "./.opencode/plugin/version-check.ts",
    "./.opencode/plugin/harvest-guard.ts",
    "./.opencode/plugin/obs-plan-write.ts",
    "./.opencode/plugin/obs-eye.ts",
    "./.opencode/plugin/obs-hand.ts"
  ],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "question": "deny",
    "bash": {
      "*": "ask",
      "npx tsc --noEmit": "allow",
      "npx github:orobsonn/claude-harness#* init*": "allow",
      "npx -y github:orobsonn/claude-harness#* init*": "allow",
      "npx -y \"github:orobsonn/claude-harness#*\" init*": "allow",
      "npm test": "allow",
      "npm run typecheck": "allow",
      "node .opencode/plugin/lib/mark-gate.mjs *": "allow",
      "node core/opencode/plugin/lib/mark-gate.mjs *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git fetch*": "allow",
      "git pull": "allow",
      "git stash*": "allow",
      "git restore*": "allow",
      "gh *": "allow",
      "node --test *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "jq*": "allow",
      "wc*": "allow",
      "mkdir*": "allow",
      "touch*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git commit --no-verify*": "deny"
    }
  }
}
