{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Routing Config",
  "type": "object",
  "required": ["version", "roles", "constraints", "modelCapabilities"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "roles": {
      "type": "object",
      "required": ["build", "planner", "plan-reviewer", "adversary", "compliance", "security", "executor", "sniper", "test-author", "harvester", "shipper"],
      "additionalProperties": false,
      "properties": {
        "build": { "$ref": "#/definitions/roleSimple" },
        "planner": { "$ref": "#/definitions/roleSimple" },
        "plan-reviewer": { "$ref": "#/definitions/roleDual" },
        "adversary": { "$ref": "#/definitions/roleDual" },
        "compliance": { "$ref": "#/definitions/roleSimple" },
        "security": { "$ref": "#/definitions/roleSimple" },
        "executor": { "$ref": "#/definitions/roleTiers" },
        "sniper": { "$ref": "#/definitions/roleTiers" },
        "test-author": { "$ref": "#/definitions/roleSimple" },
        "harvester": { "$ref": "#/definitions/roleSimple" },
        "shipper": { "$ref": "#/definitions/roleSimple" }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["crossFamilyRoles", "requireDualOn"],
      "properties": {
        "crossFamilyRoles": { "type": "array", "items": { "type": "string" } },
        "requireDualOn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "modelCapabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["supportsReasoningEffort"],
        "properties": {
          "supportsReasoningEffort": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "roleSimple": {
      "type": "object",
      "required": ["model"],
      "properties": { "model": { "type": "string" } }
    },
    "roleDual": {
      "type": "object",
      "required": ["model", "dual"],
      "properties": {
        "model": { "type": "string" },
        "dual": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "label"],
            "properties": { "model": { "type": "string" }, "label": { "type": "string" } }
          }
        }
      }
    },
    "roleTiers": {
      "type": "object",
      "required": ["tiers"],
      "properties": {
        "tiers": {
          "type": "object",
          "required": ["low", "medium", "high"],
          "properties": {
            "low": { "$ref": "#/definitions/roleSimple" },
            "medium": { "$ref": "#/definitions/roleSimple" },
            "high": { "$ref": "#/definitions/roleSimple" }
          }
        }
      }
    }
  }
}
