{
  "name": "@orobsonn/claude-harness",
  "version": "3.4.0",
  "description": "One-command vendoring of the Claude Harness delivery pipeline into a project's .claude/",
  "type": "module",
  "bin": {
    "claude-harness": "core/claude-code/skills/initializing-projects/references/cli.mjs",
    "pi-harness": "core/pi/bin/pi-harness.mjs",
    "harness-control-plane": "core/control-plane/bin/harness-control-plane.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "core/claude-code/skills/initializing-projects/references/cli.mjs",
    "core/claude-code/skills/initializing-projects/references/setup-vps.mjs",
    "core/claude-code/skills/initializing-projects/references/vendor-core.mjs",
    "core/opencode",
    "core/github",
    "core/orca",
    "core/control-plane",
    "core/shared",
    "core/claude-code",
    "core/codex",
    "core/pi"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"core/**/*.test.mjs\" \"modules/**/*.test.mjs\" \"scripts/**/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orobsonn/claude-harness.git"
  },
  "keywords": [
    "claude-code",
    "claude-harness",
    "vendoring",
    "delivery-pipeline"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@gotgenes/pi-subagents": "21.7.4"
  },
  "pi": {
    "extensions": [
      "./core/pi/extensions/harness-policy.ts",
      "./core/pi/extensions/harness-task-events.ts",
      "./core/pi/extensions/harness-task-run.ts",
      "./core/pi/extensions/harness-bootstrap.ts",
      "./core/pi/extensions/harness-planning-tools.ts",
      "./core/pi/extensions/harness-subagents.ts",
      "./core/pi/extensions/harness-dispatch.ts",
      "./core/pi/extensions/harness-memory.ts",
      "./core/pi/extensions/harness-tasks.ts",
      "./core/pi/extensions/harness-entry-gate.ts",
      "./core/pi/extensions/harness-reviews.ts",
      "./core/pi/extensions/harness-plan-gate.ts",
      "./core/pi/extensions/harness-plan-write-gate.ts",
      "./core/pi/extensions/harness-marker.ts",
      "./core/pi/extensions/harness-classify.ts",
      "./core/pi/extensions/harness-spec.ts",
      "./core/pi/extensions/harness-lavish-gate.ts",
      "./core/pi/extensions/harness-obs.ts",
      "./core/pi/extensions/harness-idle-nudge.ts",
      "./core/pi/extensions/harness-reinject-state.ts",
      "./core/pi/extensions/harness-version-check.ts",
      "./core/pi/extensions/harness-context-files.ts",
      "./core/pi/extensions/harness-plan-tracker.ts"
    ],
    "skills": [
      "./core/codex/skills",
      "./core/pi/skills"
    ]
  }
