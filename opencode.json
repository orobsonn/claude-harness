{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.3",
  "small_model": "xai/grok-build-0.1",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "./.opencode/plugin/entry-gate.ts",
    "./.opencode/plugin/plan-gate.ts",
    "./.opencode/plugin/loop-guard.ts",
    "./.opencode/plugin/reinject-state.ts",
    "./.opencode/plugin/version-check.ts",
    "./.opencode/plugin/harvest-guard.ts",
    "./.opencode/plugin/obs-plan-write.ts",
    "./.opencode/plugin/obs-eye.ts"
  ],
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "question": "deny",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -fr /": "deny",
      "rm -fr /*": "deny",
      "git add .": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git commit --no-verify*": "deny"
    }
  }
}
