{
  "version": 1,
  "harnessVersion": "v2.4.2",
  "owned": {
    "permissions": {
      "allow": [
        "Edit",
        "Write",
        "Bash(git status:*)",
        "Bash(git log:*)",
        "Bash(git diff:*)",
        "Bash(git show:*)",
        "Bash(git add:*)",
        "Bash(git commit:*)",
        "Bash(git push)",
        "Bash(git push --force-with-lease:*)",
        "Bash(git push * --force-with-lease:*)",
        "Bash(git branch:*)",
        "Bash(git checkout:*)",
        "Bash(git switch:*)",
        "Bash(git fetch:*)",
        "Bash(git pull)",
        "Bash(git stash:*)",
        "Bash(git restore:*)",
        "Bash(gh:*)",
        "Bash(ls:*)",
        "Bash(cat:*)",
        "Bash(head:*)",
        "Bash(tail:*)",
        "Bash(wc:*)",
        "Bash(find:*)",
        "Bash(grep:*)",
        "Bash(rg:*)",
        "Bash(which:*)",
        "Bash(pwd)",
        "Bash(echo:*)",
        "Bash(sort:*)",
        "Bash(uniq:*)",
        "Bash(sed:*)",
        "Bash(awk:*)",
        "Bash(diff:*)",
        "Bash(stat:*)",
        "Bash(file:*)",
        "Bash(jq:*)",
        "Bash(mkdir:*)",
        "Bash(touch:*)",
        "Bash(cp:*)",
        "Bash(mv:*)",
        "Bash(npm test:*)",
        "Bash(npm run:*)",
        "Bash(npm ci:*)",
        "Bash(npm list:*)",
        "Bash(npm info:*)",
        "Bash(pnpm test:*)",
        "Bash(pnpm run:*)",
        "Bash(yarn test:*)",
        "Bash(bun test:*)",
        "Bash(bun run:*)",
        "Bash(vitest:*)",
        "Bash(vitest run:*)",
        "Bash(jest:*)",
        "Bash(tsc --noEmit:*)",
        "Bash(eslint:*)",
        "Bash(prettier:*)",
        "Bash(node:*)"
      ],
      "deny": [
        "Read(.env)",
        "Read(.env.*)",
        "Read(//**/.env)",
        "Read(//**/.env.*)",
        "Read(.dev.vars)",
        "Read(//**/.dev.vars)",
        "Read(~/.ssh/**)",
        "Read(~/.aws/**)",
        "Bash(git reset --hard:*)",
        "Bash(git push --force *)",
        "Bash(git push * --force *)",
        "Bash(git push -f*)",
        "Bash(git push * -f*)",
        "Bash(git clean -f*)",
        "Bash(wrangler deploy*)",
        "Bash(wrangler versions*)",
        "Bash(wrangler secret*)",
        "Bash(wrangler r2*)",
        "Bash(wrangler d1 execute --remote*)",
        "Bash(wrangler d1 execute * --remote*)",
        "Bash(npx wrangler deploy*)",
        "Bash(npx wrangler versions*)",
        "Bash(npx wrangler secret*)",
        "Bash(npx wrangler r2*)",
        "Bash(npx wrangler d1 execute --remote*)",
        "Bash(npx wrangler d1 execute * --remote*)",
        "Bash(npm run deploy*)",
        "Bash(pnpm run deploy*)",
        "Bash(yarn deploy*)",
        "Bash(bun run deploy*)"
      ],
      "defaultMode": "acceptEdits"
    },
    "autoMemoryDirectory": ".claude/memory",
    "env": {
      "HARNESS_CODEX_ADVERSARY": "0",
      "HARNESS_REVIEW_ENABLED": "1"
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/entry-gate.mjs"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/entry-gate.mjs"
            },
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/lavish-command-gate.mjs"
            }
          ]
        },
        {
          "matcher": "ScheduleWakeup",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/entry-gate.mjs"
            }
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/plan-write-gate.mjs"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/stamp-triage.mjs"
            },
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/vps-access-nudge.mjs"
            }
          ]
        },
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/codex-eye-nudge.mjs"
            },
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/obs-eye-append.mjs"
            },
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-idle-nudge.mjs"
            }
          ]
        },
        {
          "matcher": "Write",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/obs-plan-write.mjs"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/reinject-state.mjs"
            }
          ]
        },
        {
          "matcher": "startup",
          "hooks": [
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/reinject-state.mjs"
            },
            {
              "type": "command",
              "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/version-check.mjs"
            }
          ]
        }
      ]
    }
  }
}
